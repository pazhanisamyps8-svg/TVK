•	Configure DHCP     My system Ip 192.168.13.13
                        sudo vi /etc/dhcp/dhcpd.conf
Add this Line 

default-lease-time 600;
max-lease-time 7200;

authoritative;

subnet 192.168.13.0 netmask 255.255.255.0 {

range 192.168.13.100 192.168.13.200;

option routers 192.168.13.13;

option domain-name-servers 8.8.8.8;

next-server 192.168.13.13;

filename "EFI/BOOT/BOOTX64.EFI";

}
•	Start The Service
sudo systemctl enable dhcpd
sudo systemctl restart dhcpd
•	Configure TFTP    sudo mkdir -p /var/lib/tftpboot/EFI/BOOT
•	Copy EFI bootloader  sudo cp /boot/efi/EFI/rocky/shimx64.efi \                                           /var/lib/tftpboot/EFI/BOOT/BOOTX64.EFI
 sudo cp /boot/efi/EFI/rocky/grubx64.efi \
/var/lib/tftpboot/EFI/BOOT/grubx64.efi
•	Copy Kernel  sudo mkdir -p /var/lib/tftpboot/images
cp /mnt/rocky/images/pxeboot/vmlinuz \
/var/lib/tftpboot/images/
cp /mnt/rocky/images/pxeboot/initrd.img \
/var/lib/tftpboot/images/
•	Create grub.cfg   sudo mkdir -p /var/lib/tftpboot/EFI/BOOT
 sudo vi /var/lib/tftpboot/EFI/BOOT/grub.cfg

set default=0
set timeout=5

menuentry 'Install Rocky Linux 9.8' {

linuxefi /images/vmlinuz \
inst.repo=http://192.168.13.13/rocky9

initrdefi /images/initrd.img

}
